<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Baja cliente</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <div class="header">
        <h1>Baja de cliente</h1>
    </div>

    <a href="/cliente">Volver</a>
    <ul>
        <li><a href="/cliente/Alta">Dar de alta</a></li>
        <li><a href="/cliente/Baja">Dar de baja</a></li>
        <li><a href="/cliente/Mod">Modificar cliente</a></li>
        <li><a href="/cliente/Cons">Consultar cliente</a></li>
        <li><a href="/cliente/Most">Mostrar todos</a></li>
    </ul>

    <% if (typeof error !== 'undefined' && error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form method="POST" action="/cliente/Baja">
        <p>ID del cliente a dar de baja: <input type="text" name="idCliente"></p>
        <button type="submit">Eliminar</button>
    </form>
</body>
</html>
