<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta empleado</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <div class="header">
        <h1>Alta de empleado</h1>
    </div>

    <a href="/empleado">Volver</a>

    <ul>
        <li><a href="/empleado/Alta">Dar de alta</a></li>
        <li><a href="/empleado/Baja">Dar de baja</a></li>
        <li><a href="/empleado/Mod">Modificar empleado</a></li>
        <li><a href="/empleado/Cons">Consultar empleado</a></li>
        <li><a href="/empleado/Most">Mostrar todos</a></li>
    </ul>

    <% if (typeof error !== 'undefined' && error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form method="POST" action="/empleado/Alta">
        <p>ID: <input type="text" name="idEmpleado"></p>
        <p>Nombre: <input type="text" name="nombreE"></p>
        <p>Cargo: <input type="text" name="cargoE"></p>
        <p>Turno: <input type="text" name="turnoE"></p>     
        <button type="submit">Guardar</button>
    </form>
</body>
</html>