<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta producto</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <div class="header">
        <h1>Alta de producto</h1>
    </div>

    <a href="/productos">Volver</a>

    <ul>
        <li><a href="/productos/Alta">Dar de alta</a></li>
        <li><a href="/productos/Baja">Dar de baja</a></li>
        <li><a href="/productos/Mod">Modificar producto</a></li>
        <li><a href="/productos/Cons">Consultar producto</a></li>
        <li><a href="/productos/Most">Mostrar todos</a></li>
    </ul>

    <% if (typeof error !== 'undefined' && error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form action="/productos/Alta" method="post" >
        <p>Id</p>
        <input type="text" name="idhtml" placeholder="id">
        <p>Nombre</p>
        <input type="text" name="nomhtml" placeholder="nombre">
        <p>Categoria</p>
        <input type="text" name="categoriahtml" placeholder="categoria">
        <p>Precio</p>
        <input type="text" name="preciohtml" placeholder="precio">
        

        <input type="submit" name="AGREGAR" >
        
        
    </form>
</body>
</html>
