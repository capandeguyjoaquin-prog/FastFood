<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Baja producto</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <div class="header">
        <h1>Baja de producto</h1>
    </div>

    <a href="/productos">Volver</a>

    <ul>
        <li><a href="/productos/Alta">Dar de alta</a></li>
        <li><a href="/productos/Baja">Dar de baja</a></li>
        <li><a href="/productos/Mod">Modificar producto</a></li>
        <li><a href="/productos/Cons">Consultar producto</a></li>
        <li><a href="/productos/Most">Mostrar todos</a></li>
    </ul>

    <% if (typeof error !== 'undefined' && error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form method="POST" action="/productos/Baja">
        <p>ID del producto a dar de baja: <input type="text" name="idhtml" placeholder="ID del producto">
        <button type="submit" name="eliminar">Eliminar</button>
    </form>
</body>
</html>
