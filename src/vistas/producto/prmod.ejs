<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar producto</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <header class="encabezado-principal">
    <a class="volver-inicio" href="/">Volver al inicio</a>
    <div class="marca">
        <div class="texto-marca">
            <h1>MODIFICAR PRODUCTO</h1>
        </div>
    </div>
</header>

    <main class="contenedor-principal">

    

    <nav class="menu-principal" aria-label="Apartados de productos">
    <a class="opcion-menu" href="/productos/Alta">
        <img class="imagen-opcion" src="/img/productos.jpg" alt="">
        <span>Dar de alta</span>
    </a>
    <a class="opcion-menu" href="/productos/Baja">
        <img class="imagen-opcion" src="/img/productos.jpg" alt="">
        <span>Dar de baja</span>
    </a>
    <a class="opcion-menu" href="/productos/Mod">
        <img class="imagen-opcion" src="/img/productos.jpg" alt="">
        <span>Modificar producto</span>
    </a>
    <a class="opcion-menu" href="/productos/Cons">
        <img class="imagen-opcion" src="/img/productos.jpg" alt="">
        <span>Consultar producto</span>
    </a>
    <a class="opcion-menu" href="/productos/Most">
        <img class="imagen-opcion" src="/img/productos.jpg" alt="">
        <span>Mostrar todos</span>
    </a>
</nav>

    <% if (typeof error !== 'undefined' && error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form class="formulario-datos" action="/productos/Mod" method="post" >
        <p>Id</p>
        <input type="text" name="idhtml" placeholder="id">
        <p>Nombre</p>
        <input type="text" name="nomhtml" placeholder="nombre">
        <p>Categoria</p>
        <input type="text" name="categoriahtml" placeholder="categoria">
        <p>Precio</p>
        <input type="text" name="preciohtml" placeholder="precio">
        

        <input type="submit" name="AGREGAR" >
        
        
    </form>
    </main>
</body>
</html>
