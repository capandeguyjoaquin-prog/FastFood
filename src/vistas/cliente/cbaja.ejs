<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Baja cliente</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <header class="encabezado-principal">
    <a class="volver-inicio" href="/">Volver al inicio</a>
    <div class="marca">
       <div class="texto-marca">
            <h1>BAJA DE CLIENTE</h1>
        </div>
    </div>
</header>

    <main class="contenedor-principal">

    
    <nav class="menu-principal" aria-label="Apartados de clientes">
    <a class="opcion-menu" href="/cliente/Alta">
        <img class="imagen-opcion" src="/img/altacliente.png" alt="">
        <span>Dar de alta</span>
    </a>
    <a class="opcion-menu" href="/cliente/Baja">
        <img class="imagen-opcion" src="/img/bajacliente.png" alt="">
        <span>Dar de baja</span>
    </a>
    <a class="opcion-menu" href="/cliente/Mod">
        <img class="imagen-opcion" src="/img/modcliente.png" alt="">
        <span>Modificar cliente</span>
    </a>
    <a class="opcion-menu" href="/cliente/Cons">
        <img class="imagen-opcion" src="/img/conscliente.png" alt="">
        <span>Consultar cliente</span>
    </a>
    <a class="opcion-menu" href="/cliente/Most">
        <img class="imagen-opcion" src="/img/mostcliente.png" alt="">
        <span>Mostrar todos</span>
    </a>
</nav>
    <% if (error) { %>
          <p class="mensaje-error"><%= error %></p>
        <% } %>
        <% if (mensaje) { %>
          <p class="mensaje-exito"><%= mensaje %></p>
        <% } %>

    <form class="formulario-datos" method="POST" action="/cliente/Baja">
        <p>ID del cliente a dar de baja: <input type="text" name="idhtml" placeholder="ID del cliente">
        <button type="submit" name="eliminar">Eliminar</button>
    </form>
    </main>
</body>
</html>
