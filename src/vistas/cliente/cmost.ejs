<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mostrar clientes</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <header class="encabezado-principal">
    <a class="volver-inicio" href="/">Volver al inicio</a>
    <div class="marca">
        <div class="texto-marca">
            <h1>MOSTRAR TODOS LOS CLIENTES</h1>
        </div>
    </div>
</header>

    <main class="contenedor-principal">
        <nav class="menu-principal" aria-label="Apartados de clientes">
    <a class="opcion-menu" href="/cliente/Alta">
        <img class="imagen-opcion" src="/img/cliente.jpg" alt="">
        <span>Dar de alta</span>
    </a>
    <a class="opcion-menu" href="/cliente/Baja">
        <img class="imagen-opcion" src="/img/cliente.jpg" alt="">
        <span>Dar de baja</span>
    </a>
    <a class="opcion-menu" href="/cliente/Mod">
        <img class="imagen-opcion" src="/img/cliente.jpg" alt="">
        <span>Modificar cliente</span>
    </a>
    <a class="opcion-menu" href="/cliente/Cons">
        <img class="imagen-opcion" src="/img/cliente.jpg" alt="">
        <span>Consultar cliente</span>
    </a>
    <a class="opcion-menu" href="/cliente/Most">
        <img class="imagen-opcion" src="/img/cliente.jpg" alt="">
        <span>Mostrar todos</span>
    </a>
</nav>
    
        
    

    <table class="tabla-datos">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Teléfono</th>
                <th>Dirección</th>
            </tr>
        </thead>
         <tbody>
  


     <% if(registros.length > 0){
        registros.forEach(cli=>{%>
            
            <tr>

            <td><%= cli.idCliente %></td>

            <td><%=cli.nombreC %></td>

            <td><%=cli.apellidoC %></td>

            <td><%=cli.telefonoC %></td>   

            <td><%=cli.direccionC %></td>
             
            </tr>
            
       <% })
     }else{%>
        <p>no hay clientes</p>
    <% } %> 
    </tbody>

    </table>
    </main>
</body>
</html>
