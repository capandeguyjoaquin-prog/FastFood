<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta cliente</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    

    <div class="header">
        <h1>Alta de cliente</h1>
    </div>
    <a href="/cliente">Volver</a>

    <ul>
        <li><a href="/cliente/Alta">Dar de alta</a></li>
        <li><a href="/cliente/Baja">Dar de baja</a></li>
        <li><a href="/cliente/Mod">Modificar cliente</a></li>
        <li><a href="/cliente/Cons">Consultar cliente</a></li>
        <li><a href="/cliente/Most">Mostrar todos</a></li>
    </ul>

    <form action="/cliente/Alta" method="post" >
        <p>Id</p>
        <input type="text" name="idhtml" placeholder="id">
        <p>Nombre</p>
        <input type="text" name="nomhtml" placeholder="nombre">
        <p>Apellido</p>
        <input type="text" name="apellidohtml" placeholder="apellido">
        <p>Telefono</p>
        <input type="text" name="telhtml" placeholder="telefono">
        <p>Direccion</p>
        <input type="text" name="dirhtml" placeholder="direccion">
        

        <input type="submit" name="AGREGAR" >
        
        
    </form>
</body>
</html>