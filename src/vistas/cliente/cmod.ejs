<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar cliente</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <header class="encabezado-principal">
    <a class="volver-inicio" href="/">Volver al inicio</a>
    <div class="marca">
        <div class="texto-marca">
            <h1>MODIFICAR CLIENTE</h1>
        </div>
    </div>
</header>

    <main class="contenedor-principal">

    
    <nav class="menu-principal" aria-label="Apartados de clientes">
    <a class="opcion-menu" href="/cliente/Alta">
        <img class="imagen-opcion" src="/img/cliente.jpg" alt="">
        <span>Dar de alta</span>
    </a>
    <a class="opcion-menu" href="/cliente/Baja">
        <img class="imagen-opcion" src="/img/cliente.jpg" alt="">
        <span>Dar de baja</span>
    </a>
    <a class="opcion-menu" href="/cliente/Mod">
        <img class="imagen-opcion" src="/img/cliente.jpg" alt="">
        <span>Modificar cliente</span>
    </a>
    <a class="opcion-menu" href="/cliente/Cons">
        <img class="imagen-opcion" src="/img/cliente.jpg" alt="">
        <span>Consultar cliente</span>
    </a>
    <a class="opcion-menu" href="/cliente/Most">
        <img class="imagen-opcion" src="/img/cliente.jpg" alt="">
        <span>Mostrar todos</span>
    </a>
</nav>

        <% if (error) { %>
          <p class="mensaje-error"><%= error %></p>
        <% } %>
        <% if (mensaje) { %>
          <p class="mensaje-exito"><%= mensaje %></p>
        <% } %>

    <form class="formulario-datos" action="/cliente/Mod" method="post" >
        <p>Id</p>
        <input type="text" name="idhtml" placeholder="id">
        <p>Nombre</p>
        <input type="text" name="nomhtml" placeholder="nombre">
        <p>Apellido</p>
        <input type="text" name="apellidohtml" placeholder="apellido">
        <p>Telefono</p>
        <input type="text" name="telhtml" placeholder="telefono">
        <p>Direccion</p>
        <input type="text" name="dirhtml" placeholder="direccion">
        

        <input type="submit" name="AGREGAR" >
        
        
    </form>
    
    </main>
</body>
</html>
