<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mostrar empleados</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <header class="encabezado-principal">
    <a class="volver-inicio" href="/">Volver al inicio</a>
    <div class="marca">
        <div class="texto-marca">
            <h1>MOSTRAR TODOS LOS EMPLEADOS</h1>
        </div>
    </div>
</header>

    <main class="contenedor-principal">
        <nav class="menu-principal" aria-label="Apartados de empleados">
    <a class="opcion-menu" href="/empleado/Alta">
        <img class="imagen-opcion" src="/img/altaempleado.png" alt="">
        <span>Dar de alta</span>
    </a>
    <a class="opcion-menu" href="/empleado/Baja">
        <img class="imagen-opcion" src="/img/bajaempleado.png" alt="">
        <span>Dar de baja</span>
    </a>
    <a class="opcion-menu" href="/empleado/Mod">
        <img class="imagen-opcion" src="/img/modempleado.png" alt="">
        <span>Modificar empleado</span>
    </a>
    <a class="opcion-menu" href="/empleado/Cons">
        <img class="imagen-opcion" src="/img/consempleado.png" alt="">
        <span>Consultar empleado</span>
    </a>
    <a class="opcion-menu" href="/empleado/Most">
        <img class="imagen-opcion" src="/img/mostempleado.png" alt="">
        <span>Mostrar todos</span>
    </a>
</nav>

    

    <table class="tabla-datos">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Cargo</th>
                <th>Turno</th>
            </tr>
        </thead>
        <tbody>
            <% if (registros && registros.length > 0) { %>
                <% registros.forEach(emp => { %>
                    <tr>
                        <td><%= emp.idEmpleado %></td>
                        <td><%= emp.nombreE %></td>
                        <td><%= emp.cargoE %></td>
                        <td><%= emp.turnoE %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4">No hay empleados</td>
                </tr>
            <% } %>
        </tbody>
    </table>
    </main>
</body>
</html>
