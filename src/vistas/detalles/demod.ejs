<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar detalle</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <header class="encabezado-principal">
    <a class="volver-inicio" href="/">Volver al inicio</a>
    <div class="marca">
        <div class="texto-marca">
             <h1>MODIFICAR DETALLE</h1>
        </div>
    </div>
</header>

    <main class="contenedor-principal">

    
    <nav class="menu-principal" aria-label="Apartados del detalle de pedidos">
    <a class="opcion-menu" href="/detalle/Alta">
        <img class="imagen-opcion" src="/img/detalle.webp" alt="">
        <span>Dar de alta</span>
    </a>
    <a class="opcion-menu" href="/detalle/Baja">
        <img class="imagen-opcion" src="/img/detalle.webp" alt="">
        <span>Dar de baja</span>
    </a>
    <a class="opcion-menu" href="/detalle/Mod">
        <img class="imagen-opcion" src="/img/detalle.webp" alt="">
        <span>Modificar detalle</span>
    </a>
    <a class="opcion-menu" href="/detalle/Cons">
        <img class="imagen-opcion" src="/img/detalle.webp" alt="">
        <span>Consultar detalle</span>
    </a>
    <a class="opcion-menu" href="/detalle/Most">
        <img class="imagen-opcion" src="/img/detalle.webp" alt="">
        <span>Mostrar todos</span>
    </a>
</nav>

    <% if (typeof error !== 'undefined' && error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form class="formulario-datos" action="/detalle/Mod" method="post" >
        <p>Id</p>
        <input type="number" name="idhtml" placeholder="id" required>
        <p>Cantidad</p>
        <input type="number" name="cantidadhtml" placeholder="cantidad" min="1" step="1" required>
        <p>Id Producto</p>
        <input type="number" name="idproductohtml" placeholder="id producto" required>
        <p>Id Pedido</p>
        <input type="number" name="idpedidohtml" placeholder="id pedido" required>
        

        <input type="submit" name="AGREGAR" >
        
        
    </form>
    
    </main>
</body>
</html>
