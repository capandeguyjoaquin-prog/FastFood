<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar producto</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <div class="header">
        <h1>Modificar producto</h1>
    </div>

    <a href="/productos">Volver</a>

    <ul>
        <li><a href="/productos/Alta">Dar de alta</a></li>
        <li><a href="/productos/Baja">Dar de baja</a></li>
        <li><a href="/productos/Mod">Modificar producto</a></li>
        <li><a href="/productos/Cons">Consultar producto</a></li>
        <li><a href="/productos/Most">Mostrar todos</a></li>
    </ul>

    <% if (typeof error !== 'undefined' && error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form method="POST" action="/productos/Mod">
        <p>ID: <input type="text" name="idProducto"></p>
        <p>Nombre: <input type="text" name="nombreP"></p>
        <p>Categoria: <input type="text" name="categoriaP"></p>
        <p>Precio: <input type="text" name="precio_unitarioP"></p>
        <button type="submit">Actualizar</button>
    </form>
</body>
</html>
