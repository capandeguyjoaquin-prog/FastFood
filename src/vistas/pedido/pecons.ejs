<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consultar pedido y detalles</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <header class="encabezado-principal">
        <a class="volver-inicio" href="/">Volver al inicio</a>
        <div class="marca">
            <div class="texto-marca">
                <h1>CONSULTAR PEDIDO Y DETALLES</h1>
            </div>
        </div>
    </header>

    <main class="contenedor-principal">
    

    

    <nav class="menu-principal" aria-label="Apartados de pedidos">
    <a class="opcion-menu" href="/pedido/Alta">
        <img class="imagen-opcion" src="/img/pedido.png" alt="">
        <span>Dar de alta</span>
    </a>
    <a class="opcion-menu" href="/pedido/Baja">
        <img class="imagen-opcion" src="/img/pedido.png" alt="">
        <span>Dar de baja</span>
    </a>
    <a class="opcion-menu" href="/pedido/Mod">
        <img class="imagen-opcion" src="/img/pedido.png" alt="">
        <span>Modificar pedido</span>
    </a>
    <a class="opcion-menu" href="/pedido/Cons">
        <img class="imagen-opcion" src="/img/pedido.png" alt="">
        <span>Consultar pedido</span>
    </a>
    <a class="opcion-menu" href="/pedido/Most">
        <img class="imagen-opcion" src="/img/pedido.png" alt="">
        <span>Mostrar todos</span>
    </a>
</nav>

        <% if (error) { %>
            <p><%= error %></p>
        <% } %>

        <form class="formulario-datos" action="/pedido/Cons" method="post">
            <label for="pedidoId">ID del pedido</label>
            <input id="pedidoId" type="number" name="idhtml" required>
            <button type="submit">Consultar</button>
        </form>

        <% if (pedido) { %>
            <h2>Datos del pedido</h2>
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>id</th>
                        <th>Fecha y hora</th>
                        <th>Tipo de servicio</th>
                        <th>Estado</th>
                        <th>Cliente</th>
                        <th>Empleado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><%= pedido.idPedido %></td>
                        <td><%= new Date(pedido.fecha_pedidosPe).toLocaleString('es-AR') %></td>
                        <td><%= pedido.tipo_servicioPe %></td>
                        <td><%= pedido.estadoPe %></td>
                        <td><%= pedido.nombreCliente %></td>
                        <td><%= pedido.nombreEmpleado %></td>
                    </tr>
                </tbody>
            </table>

            <h2>Detalles del pedido</h2>
            <% if (detalles.length > 0) { %>
                <table class="tabla-datos">
                    <thead>
                        <tr>
                            <th>ID detalle</th>
                            <th>Cantidad</th>
                            <th>Subtotal</th>
                            <th>Producto</th>
                            <th>ID pedido</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% detalles.forEach(detalle => { %>
                            <tr>
                                <td><%= detalle.idDetalle %></td>
                                <td><%= detalle.cantidadDeta %></td>
                                <td><%= detalle.subtotalDeta %></td>
                                <td><%= detalle.nombreProducto %></td>
                                <td><%= detalle.Pedidos_idPedido %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p>Este pedido no tiene detalles.</p>
            <% } %>
        <% } %>
    </main>
</body>
</html>