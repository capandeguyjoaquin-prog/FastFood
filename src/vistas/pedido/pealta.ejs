<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta pedido</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <header class="encabezado-principal">
    <a class="volver-inicio" href="/">Volver al inicio</a>
    <div class="marca">
        <div class="texto-marca">
            <h1>ALTA DE PEDIDO</h1>
        </div>
    </div>
</header>

    <main class="contenedor-principal">
    

    

    <nav class="menu-principal" aria-label="Apartados de pedidos">
    <a class="opcion-menu" href="/pedido/Alta">
        <img class="imagen-opcion" src="/img/pedido.png" alt="">
        <span>Dar de alta</span>
    </a>
    <a class="opcion-menu" href="/pedido/Baja">
        <img class="imagen-opcion" src="/img/pedido.png" alt="">
        <span>Dar de baja</span>
    </a>
    <a class="opcion-menu" href="/pedido/Mod">
        <img class="imagen-opcion" src="/img/pedido.png" alt="">
        <span>Modificar pedido</span>
    </a>
    <a class="opcion-menu" href="/pedido/Cons">
        <img class="imagen-opcion" src="/img/pedido.png" alt="">
        <span>Consultar pedido</span>
    </a>
    <a class="opcion-menu" href="/pedido/Most">
        <img class="imagen-opcion" src="/img/pedido.png" alt="">
        <span>Mostrar todos</span>
    </a>
</nav>

    <form class="formulario-datos" action="/pedido/Alta" method="post">
        <p>Id</p>
        <input type="number" name="idhtml" placeholder="id">

        <p>Fecha y hora</p>
        <input type="datetime-local" name="fechahtml">

        <p>Tipo de servicio</p>
        <input type="text" name="tiposerviciohtml" placeholder="tipo de servicio">

        <p>Estado del pedido</p>
        <input type="text" name="estadopedidohtml" placeholder="estado del pedido">

        <p>ID del cliente</p>
        <input type="number" name="clienteIdhtml" placeholder="ID del cliente" required>

        <p>ID del empleado</p>
        <input type="number" name="empleadoIdhtml" placeholder="ID del empleado" required>

        <input type="submit" value="AGREGAR">
    </form>
    </main>
</body>
</html>
