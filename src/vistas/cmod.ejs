<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar cliente</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <div class="header">
        <h1>Modificar cliente</h1>
    </div>

    <a href="/cliente">Volver</a>
    <ul>
        <li><a href="/cliente/Alta">Dar de alta</a></li>
        <li><a href="/cliente/Baja">Dar de baja</a></li>
        <li><a href="/cliente/Mod">Modificar cliente</a></li>
        <li><a href="/cliente/Cons">Consultar cliente</a></li>
        <li><a href="/cliente/Most">Mostrar todos</a></li>
    </ul>

    <% if (typeof error !== 'undefined' && error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form method="POST" action="/cliente/Mod">
        <p>ID: <input type="text" name="idCliente"></p>
        <p>Nombre: <input type="text" name="nombreC"></p>
        <p>Apellido: <input type="text" name="apellidoC"></p>
        <p>Teléfono: <input type="text" name="telefonoC"></p>
        <p>Dirección: <input type="text" name="direccionC"></p>
        <button type="submit">Actualizar</button>
    </form>
</body>
</html>
